# Serper.dev key (https://serper.dev). Without it, only LinkedIn alumni links work.
SERPER_API_KEY=
# Colleges (LinkedIn school id + name variants) are listed in schools.go.
# Days before a cached Google result is re-fetched
CACHE_TTL_DAYS=7
# Max result pages per X-ray query (1 page = 1 Serper credit)
XRAY_MAX_PAGES=3
# Server binds to 127.0.0.1 only
PORT=8080
DB_PATH=./data/alumni.db
